# ═══════════════════════════════════════════════════════════
#  TheHitterBot — git ignore
# ═══════════════════════════════════════════════════════════

# ── Secrets / env ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Bot runtime state (never commit) ────────────────────────
admin.json
premium.txt
proxy.txt
user_proxies.json
user_pool.json
user_sites.json
keys.json
users_access.json
banned.json
credits.json
nopecha.json

# ── Logs ────────────────────────────────────────────────────
*.log
logs/
bot.log
bot_error.log
error.txt

# ── Generated output ────────────────────────────────────────
charged.txt
approved.txt
hits.txt

# ── Telethon session files ──────────────────────────────────
*.session
*.session-journal
checker_bot.session*

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
env/
ENV/
.venv/

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Sites (either local fallback or freshly built) ──────────
# Uncomment these if you DON'T want sites cached in the repo
# sites.txt
# sites_*.txt
# data/bins.json.gz
